{
  "name": "Brace JSON Formatter",
  "short_name": "Brace",
  "description": "Format, validate and repair JSON. Private: nothing you paste leaves your device.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#e3e4e8",
  "theme_color": "#ffbf00",
  "icons": [
    { "src": "icons/icon.svg", "sizes": "any", "type": "image/svg+xml" },
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png" }
  ]
}
